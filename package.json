{
  "name": "doclock",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "expo run:android --variant release --no-install",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "expo run:android --variant release --no-install",
    "build:apk": "npx eas-cli build --platform android --profile preview",
    "build:apk:production": "npx eas-cli build --platform android --profile production",
    "dev": "expo run:android",
    "dev:fast": "expo run:android --no-build-cache",
    "dev:clean": "cd android && ./gradlew clean && cd .. && expo run:android",
    "test:android:emulator": "npm run build:android:debug && adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "test:android:emulator:release": "npm run build:android && adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "test:android:device": "npm run build:android:debug && adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb shell am start -n com.techvriksha.doclock/.MainActivity",
    "release:device": "expo run:android --variant release",
    "release:build": "expo run:android --variant release --no-install",
    "release:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk && adb shell am start -n com.techvriksha.doclock/.MainActivity",
    "build:release:install": "./build-and-install-release.sh",
    "test:android:device:release": "expo run:android --variant release",
    "test:android:device:release:manual": "npm run build:android:release && adb install -r android/app/build/outputs/apk/release/app-release.apk && adb shell am start -n com.techvriksha.doclock/.MainActivity",
    "test:ios:simulator": "expo run:ios",
    "devices:list": "adb devices",
    "emulator:list": "emulator -list-avds",
    "emulator:start": "emulator -avd"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-firebase/app": "^23.8.2",
    "@react-native-firebase/auth": "^23.8.2",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-blur": "~14.0.0",
    "expo-build-properties": "~0.13.3",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-device": "~7.0.3",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.0",
    "expo-media-library": "~17.0.6",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.0",
    "firebase": "^12.7.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-activity-indicator": "^0.0.4",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.8.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-webview": "^13.16.0"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@types/react-native": "^0.72.8",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.3.3"
  }
}
